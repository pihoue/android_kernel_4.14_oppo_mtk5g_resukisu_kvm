+FUNCTION_INVARIANT_ZERO(id_aa64smfr0_el1)
+FUNCTION_INVARIANT_ZERO(id_aa64dfr1_el1)
+FUNCTION_INVARIANT_ZERO(id_aa64isar2_el1)
+
